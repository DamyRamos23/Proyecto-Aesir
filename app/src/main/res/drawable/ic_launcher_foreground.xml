<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo de ODIN: el Valknut del reto contrarreloj (centro del escudo de Mundos),
  en dorado sobre un medallón oscuro con aro de hierro y aro de brasa.
  Misma geometría que dibujarValknut. Todo dentro de la zona segura (66dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sombra del medallón -->
    <path android:fillColor="#99000000" android:pathData="M54,25a31,31 0,1 1,0 62a31,31 0,1 1,0 -62z" />
    <!-- Medallón -->
    <path android:pathData="M54,23a31,31 0,1 1,0 62a31,31 0,1 1,0 -62z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="31">
                <item android:offset="0" android:color="#FF2E271F" />
                <item android:offset="1" android:color="#FF12100D" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Aro de hierro -->
    <path android:fillColor="#00000000" android:strokeColor="#FF3A3229" android:strokeWidth="3"
        android:pathData="M54,24.5a29.5,29.5 0,1 1,0 59a29.5,29.5 0,1 1,0 -59z" />
    <!-- Aro de brasa -->
    <path android:fillColor="#00000000" android:strokeColor="#FFF0B85A" android:strokeWidth="1.6"
        android:pathData="M54,29a25,25 0,1 1,0 50a25,25 0,1 1,0 -50z" />
    <!-- Valknut -->
    <path android:fillColor="#00000000" android:strokeColor="#FFC9A35B" android:strokeWidth="2"
        android:strokeLineJoin="miter" android:pathData="M54.00,32.38L66.35,53.77L41.65,53.77ZM60.37,43.42L72.72,64.81L48.02,64.81ZM47.63,43.42L59.98,64.81L35.28,64.81Z" />
</vector>
